# 复制为 .env 后填写；.env 不入 Git
# MySQL 8（见 ADR-004）
DATABASE_URL=mysql+pymysql://root:你的密码@127.0.0.1:3306/kbqa?charset=utf8mb4

# DeepSeek（OpenAI 兼容）
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 路径（默认取仓库根下的 data / runtime/models，可覆盖）
# DATA_DIR=D:\bishe\data
# MODEL_DIR=D:\bishe\runtime\models

# 服务
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO
